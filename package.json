{
  "name": "opennoillirk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3052",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy --config wrangler.production.jsonc",
    "db:local": "wrangler d1 migrations apply opennoillirk --local",
    "db:remote": "wrangler d1 migrations apply opennoillirk --remote --config wrangler.production.jsonc",
    "test:browser": "node scripts/browser-audit.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "playwright": "^1.58.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
