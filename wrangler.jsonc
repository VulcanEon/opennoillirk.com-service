{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opennoillirk",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-19",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "opennoillirk", "database_id": "local-opennoillirk", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "opennoillirk-assets" }],
  "vars": { "SITE_URL": "http://localhost:3052", "LOCAL_DEVELOPMENT": "true" },
  "observability": { "enabled": true }
}
